        },
        "encoding": "utf-8",
        "failover_hosts": [
          "prod-db-replica-01.internal",
          "prod-db-replica-02.internal"
        ],
        "host": "prod-cluster-db.internal",
        "pool": 10,
        "ssl": {
          "cert_path": "/etc/ssl/certs/db.crt",
          "enabled": true,
          "mode": "require"
