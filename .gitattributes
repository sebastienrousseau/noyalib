# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Rust source
*.rs text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.json text eol=lf

# Shell scripts and automation
*.sh text eol=lf
Makefile text eol=lf
.editorconfig text eol=lf

# License files
LICENSE* text eol=lf

# Lock file — always LF, always diff
Cargo.lock text eol=lf -merge

# Binaries
*.png binary
*.jpg binary
*.ico binary

# Fuzz findings are byte sequences; CRLF is part of the reproducer.
fuzz/regressions/** binary
crates/noyalib/tests/fixtures/anchored-empty-key.yaml binary
crates/noyalib/tests/fixtures/unindented-mapping-value.yaml binary
crates/noyalib/tests/fixtures/explicit-key-trailing-separation.yaml binary
fuzz/corpus/** binary
fuzz-nostd/regressions/** binary
fuzz-nostd/corpus/** binary
crates/noyalib/tests/fixtures/nested-anchor-redefinition.yaml binary
*.bin binary
crates/noyalib/tests/fixtures/plain-continuation-tab-indent.yaml binary
